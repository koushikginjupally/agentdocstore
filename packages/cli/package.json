{
  "name": "agentdocstore",
  "version": "0.4.0",
  "description": "Offline-first, self-hosted store for the documents AI agents write: a web UI, a REST API and an MCP server over one versioned store.",
  "homepage": "https://github.com/koushikginjupally/agentdocstore#readme",
  "bugs": {
    "url": "https://github.com/koushikginjupally/agentdocstore/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koushikginjupally/agentdocstore.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agentdocstore": "bundle/index.js"
  },
  "files": [
    "bundle",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agentdocstore",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "documents",
    "markdown",
    "offline-first",
    "self-hosted"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node ../../scripts/finalize-build.mjs",
    "prepack": "npm run build --prefix ../..",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentdocstore/core": "^0.4.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@agentdocstore/mcp": "*",
    "@agentdocstore/provider-fs": "*",
    "@agentdocstore/provider-memory": "*",
    "@agentdocstore/server": "*",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
