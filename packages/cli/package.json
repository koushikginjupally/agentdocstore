{
  "name": "@agentdocstore/cli",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agentdocstore": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node ../../scripts/finalize-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentdocstore/core": "*",
    "@agentdocstore/provider-fs": "*",
    "@agentdocstore/provider-memory": "*",
    "@agentdocstore/server": "*",
    "@agentdocstore/mcp": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
